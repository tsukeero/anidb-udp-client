{
    // TODO: extend @tsconfig/node22 once typescript >= 5.7 (it uses es2024 libs)
    "compilerOptions": {
      "lib": ["es2023"],
      "module": "node16",
      "target": "es2022",
      "types": ["node"],
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "moduleResolution": "node16",
      "outDir": "./dist",
      "declaration": true,
      "allowJs": true,
      "useDefineForClassFields": true,
      "esModuleInterop": true,
    },
    "include": [
        "./src/index.ts"
      ],
    "ts-node": {
      "files": true
    }
  }