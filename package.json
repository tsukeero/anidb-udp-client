{
  "name": "anidb-udp-client",
  "version": "2.0.1",
  "description": "anidb-udp-client is a library for Node.js that facilitates the use of Anidb's UDP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsukeero/anidb-udp-client.git"
  },
  "homepage": "https://tsukeero.github.io/anidb-udp-client/",
  "keywords": [
    "anime",
    "anidb"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "verify": "npm run lint && npm run typecheck && npm test",
    "depcheck": "depcheck . --ignores=@commitlint/cli,@commitlint/config-conventional",
    "build": "tsc --outDir ./dist",
    "docs": "typedoc src/index.ts --excludeExternals --out ./docs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "watchman": false,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "modulePaths": [
      "src"
    ],
    "testPathIgnorePatterns": [
      "node_modules"
    ],
    "transform": {
      "\\.[jt]sx?$": "@swc/jest"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "author": "Tsukee Kage <tsukee.kage@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "bottleneck": "^2.19.5",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "depcheck": "^1.4.7",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "unrs-resolver": false
  }
}
