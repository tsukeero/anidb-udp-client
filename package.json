{
  "name": "anidb-udp-client",
  "version": "1.1.1",
  "description": "anidb-udp-client is a library for Node.js that facilitates the use of Anidb's UDP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/tsukeero/anidb-udp-client",
  "homepage": "https://tsukeero.github.io/anidb-udp-client/",
  "keywords": [
    "anime",
    "anidb"
  ],
  "scripts": {
    "ci_install": "yarn install --immutable --immutable-cache --check-cache",
    "test": "jest --coverage",
    "verify": "yarn eslint . && yarn tsc && yarn test",
    "depcheck": "depcheck .",
    "build": "tsc --outDir ./dist",
    "docs": "typedoc src/index.ts --excludeExternals --out ./docs",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "watchman": false,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "modulePaths": [
      "src"
    ],
    "testPathIgnorePatterns": [
      "node_modules"
    ],
    "transform": {
      "\\.[jt]sx?$": "@swc/jest"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "author": "Tsukee Kage <tsukee.kage@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "bottleneck": "^2.19.5",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pinst": "^3.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.18.1"
}
